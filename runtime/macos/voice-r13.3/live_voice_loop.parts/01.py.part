        return bool(response.get("ok") and response.get("ready"))
    except Exception:
        return False
    finally:
        try:
            client.close()
        except Exception:
            pass


def ensure_warm_kokoro_worker() -> None:
    global OWNED_KOKORO_WORKER

    if kokoro_worker_ready():
        print("Kokoro warm worker: READY (reused)", flush=True)
        return

    if WORKER_SOCKET.exists():
        print("Kokoro warm worker: stale socket removed", flush=True)
        try:
            WORKER_SOCKET.unlink()
        except FileNotFoundError:
            pass

    if not KOKORO_PY.is_file() or not KOKORO_WORKER.is_file():
        print(
            "Warm Kokoro worker files unavailable; safe Kokoro fallback remains enabled.",
            flush=True,
        )
        return

    KOKORO_LOG.parent.mkdir(parents=True, exist_ok=True)
    log_handle = KOKORO_LOG.open("ab")
    try:
        OWNED_KOKORO_WORKER = subprocess.Popen(
            [str(KOKORO_PY), str(KOKORO_WORKER)],
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            env={**os.environ, "TOKENIZERS_PARALLELISM": "false"},
            start_new_session=True,
        )
    finally:
        log_handle.close()

    deadline = time.monotonic() + 30.0
    while time.monotonic() < deadline:
        if kokoro_worker_ready(timeout=0.5):
            print("Kokoro warm worker: READY (new)", flush=True)
            return
        if OWNED_KOKORO_WORKER.poll() is not None:
            print(
                "Warm Kokoro worker exited; safe Kokoro fallback remains enabled.",
                flush=True,
            )
            return
        time.sleep(0.1)
    print("Warm Kokoro worker timed out; safe Kokoro fallback remains enabled.", flush=True)


atexit.register(stop_owned_kokoro_worker)
ensure_warm_kokoro_worker()


