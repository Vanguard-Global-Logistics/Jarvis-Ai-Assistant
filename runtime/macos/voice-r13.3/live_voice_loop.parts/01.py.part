class ContinuousMicReader:
    """Continuously drain shell-owned PCM so TTS can never create stale backlog."""

    def __init__(self, fifo_path: Path) -> None:
        self.fifo_path = fifo_path
        self.frames: queue.Queue[bytes] = queue.Queue(maxsize=512)
        self.stop_event = threading.Event()
        self.drop_event = threading.Event()
        self.drop_event.set()  # drop startup / TTS audio until listening is armed
        self.error: str | None = None
        self.last_frame_at = 0.0
        self.thread = threading.Thread(
            target=self._run,
            name="jarvis-mic-reader",
            daemon=True,
        )

    def start(self) -> None:
        self.thread.start()

    def _run(self) -> None:
        try:
            fd = os.open(self.fifo_path, os.O_RDONLY)
            try:
                pending = bytearray()
                while not self.stop_event.is_set():
                    chunk = os.read(fd, max(FRAME_BYTES * 8, 4096))
                    if not chunk:
                        if self.stop_event.is_set():
                            return
                        self.error = "microphone FIFO writer closed"
                        return
                    pending.extend(chunk)
                    while len(pending) >= FRAME_BYTES:
                        frame = bytes(pending[:FRAME_BYTES])
                        del pending[:FRAME_BYTES]
                        self.last_frame_at = time.monotonic()
                        if self.drop_event.is_set():
                            continue
                        try:
                            self.frames.put_nowait(frame)
                        except queue.Full:
                            # Always favor the newest live microphone audio.
                            try:
                                self.frames.get_nowait()
                            except queue.Empty:
                                pass
                            try:
                                self.frames.put_nowait(frame)
                            except queue.Full:
                                pass
            finally:
                os.close(fd)
        except Exception as exc:
            self.error = repr(exc)

    def wait_for_pcm(self, timeout: float = 10.0) -> bool:
        deadline = time.monotonic() + timeout
        baseline = self.last_frame_at
        while time.monotonic() < deadline:
            if self.error:
                return False
            if self.last_frame_at > baseline:
                return True
            time.sleep(0.05)
        return False

    def pause_and_drop(self) -> None:
        self.drop_event.set()
        self.flush()

    def resume(self) -> None:
        self.flush()
        self.drop_event.clear()

    def flush(self) -> None:
        while True:
            try:
                self.frames.get_nowait()
            except queue.Empty:
                return

    def get_frame(self, timeout: float = 0.75) -> bytes | None:
        if self.error:
            return None
        try:
            return self.frames.get(timeout=timeout)
        except queue.Empty:
            return None

    def close(self) -> None:
        self.stop_event.set()
        self.drop_event.set()
        self.flush()


MIC_FIFO = Path(os.environ.get("JARVIS_MIC_FIFO", "")).expanduser()
if not str(MIC_FIFO) or not MIC_FIFO.exists():
    raise SystemExit(
        "Shell-owned microphone FIFO is unavailable. "
        "Start Jarvis through START-JARVIS-HIVE.command."
    )

mic_reader = ContinuousMicReader(MIC_FIFO)
mic_reader.start()


def frame_rms(frame: bytes) -> float:
    import array
    samples = array.array("h")
    samples.frombytes(frame)
    if sys.byteorder != "little":
        samples.byteswap()
    if not samples:
        return 0.0
    return math.sqrt(sum(int(s) * int(s) for s in samples) / len(samples))


