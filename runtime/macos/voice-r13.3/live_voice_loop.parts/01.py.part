def aegis_state() -> str:
    try:
        data = json.loads(AEGIS_PUBLIC.read_text(encoding="utf-8"))
        state = str(data.get("state", "")).strip().lower()
    except (OSError, ValueError, TypeError):
        return "unavailable"
    return state or "unavailable"


def aegis_allows_voice() -> bool:
    # Read-only enforcement. Jarvis never writes or lowers AEGIS.
    return aegis_state() in {"optimal", "guarded", "restricted"}


initial_aegis = aegis_state()
if initial_aegis == "unavailable":
    raise SystemExit("AEGIS public state is unavailable. Voice fails closed; AEGIS was not modified.")
if not aegis_allows_voice():
    raise SystemExit(f"AEGIS state {initial_aegis!r} does not permit voice. Jarvis remains silent.")

