{
  "name": "jarvis-ai-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "Jarvis AI Assistant \u2014 production foundation (Phase 1). No application features implemented.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present && npm run assert:bundle",
    "assert:bundle": "node scripts/assert-electron-bundle.mjs",
    "dev:desktop": "npm run dev --workspace @jarvis/desktop",
    "refresh": "git pull --ff-only && npm install --no-audit --no-fund && npm run dev:desktop",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "probe:runtime": "node scripts/runtime-probe.mjs",
    "package:dir": "npm run build && electron-builder --dir --project apps/desktop --config.electronDist=../../node_modules/electron/dist",
    "package:mac": "npm run build && electron-builder --mac --project apps/desktop",
    "probe:packaged": "node scripts/runtime-probe.mjs --packaged",
    "diagnostics": "node scripts/collect-diagnostics.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
