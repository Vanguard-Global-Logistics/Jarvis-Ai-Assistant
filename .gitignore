# --- Secrets / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
*.token

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
vendor/

# --- Build output ---
dist/
build/
out/
# Installers and unpacked apps from electron-builder. Hundreds of megabytes,
# and rebuilt from source on demand — never committed.
release/
.next/
.nuxt/
.output/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Personal / local databases ---
*.sqlite
*.sqlite3
*.db

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- Claude Code local settings ---
.claude/settings.local.json

# --- Coverage / cache ---
coverage/
.cache/
.turbo/

# Generated review packets (npm run review). Build artifacts, not source: each
# one contains a full diff and is written to be pasted into a third-party chat.
# Committing them would put that text in history permanently and would tempt the
# secret scanner into refusing on its own output.
docs/review/

# Critic-swarm review prompts — generated, contain a full diff, regenerable
docs/swarm/

# Gauntlet round artifacts — copies of the graded work. The LEDGER and its machine
# half (state.json) are the audit trail and stay tracked; the A/B copies and the
# generated prompts are regenerable. state.json is NOT regenerable: without it
# `verdict` and `status` die, and `init` would truncate the tracked ledger.
docs/gauntlet/**
!docs/gauntlet/*/
!docs/gauntlet/*/ledger.md
!docs/gauntlet/*/state.json
