{
  // Main + preload: Node globals available. Trusted side of the boundary.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  // `src/shared` holds code used by BOTH the main process and the build config
  // (the CSP policy). It must never grow renderer-facing or privileged surface —
  // it is shared with a plain-Node build script, not with the untrusted renderer.
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts"
  ]
}
