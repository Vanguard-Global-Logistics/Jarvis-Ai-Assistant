# Copy this file to .env and fill in real values locally.
# Per SECURITY-BOUNDARIES.md: secrets are server-side only — never in
# clients, prompts, repos, logs, or screenshots. This file must never
# contain real values.

# --- Hive local AI (no paid model API required) ---
# Keep `off` until the local OpenJarvis sidecar is installed and accepted.
# `local-only` fails visibly if local inference is unavailable; it never
# silently falls back to a paid cloud model.
HIVE_LOCAL_AI_MODE=off
HIVE_LOCAL_AI_URL=http://127.0.0.1:8000
# Optional specialist models. When unset, every request keeps using the
# default/discovered model. Both remain inside the loopback-only provider.
HIVE_LOCAL_AI_MODEL=
HIVE_LOCAL_AI_FAST_MODEL=
HIVE_LOCAL_AI_REASONING_MODEL=

# --- Optional cloud AI providers (server-side only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data / storage ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Financial aggregation (Plaid-class, read-only scopes) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Deployment ---
VERCEL_TOKEN=

# --- App ---
NODE_ENV=development
PORT=3000
