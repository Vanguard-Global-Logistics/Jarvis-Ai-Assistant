# Copy this file to .env and fill in real values locally.
# Per SECURITY-BOUNDARIES.md: secrets are server-side only — never in
# clients, prompts, repos, logs, or screenshots. This file must never
# contain real values.

# --- AI providers (server-side only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Which Claude model to ask for. Defaults to claude-opus-4-8 (the dearest
# tier). `claude-sonnet-5` is ~60% cheaper today on introductory pricing and is
# plenty for ordinary chat; `claude-haiku-4-5` is cheaper still.
#
# The reason this exists is not cost. When a model id is RETIRED, a hardcoded
# one takes the app down and the only fix is a rebuild and a reinstall — which
# has already happened once here, to Gemini. This is the escape hatch, and it
# accepts any id, including one newer than this repo.
JARVIS_ANTHROPIC_MODEL=

# xAI / Grok (ADR 0020). Remote and paid, like Anthropic: setting this means
# conversations LEAVE this machine. Key from console.x.ai.
XAI_API_KEY=
# Optional. Defaults to grok-4. Named rather than floating on purpose — a model
# that changes under you is an assistant that changes under you.
JARVIS_XAI_MODEL=

# Google Gemini (ADR 0023). The only capable remote model with a genuinely FREE
# daily allowance — no card. Free key: aistudio.google.com
# Free in money, NOT in privacy: free-tier traffic to consumer AI APIs is
# commonly used to improve the provider's products. Paid tiers usually are not.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.7-flash. NOT 2.5-flash — Google has retired
# that one for new accounts, and a real key proved it with a 404.
JARVIS_GEMINI_MODEL=

# NVIDIA NIM (ADR 0028). 100+ open-weight models — DeepSeek, Qwen, Llama,
# Nemotron — behind one OpenAI-compatible endpoint. Free key, no card:
# build.nvidia.com
# Free in money only, and NOT unlimited: the allowance is a fixed pool of
# inference credits, not a daily refill like Gemini's. It is an evaluation
# budget — good for cross-vendor review packets, wrong as a daily brain.
# The conversation leaves this machine, so AEGIS refuses it at YELLOW and above.
NVIDIA_API_KEY=
# Optional. Defaults to meta/llama-3.3-70b-instruct. Ids are NAMESPACED —
# "deepseek-ai/deepseek-r1", not "deepseek-r1".
JARVIS_NVIDIA_MODEL=

# Name the provider outright instead of relying on precedence:
#   local | anthropic | gemini | grok | nvidia | mock
# With four configurable at once, "why did it use that one?" stops being
# obvious, and guessing wrong means either an unexpected bill or a conversation
# leaving the machine. If the named provider cannot be built, the app FAILS
# rather than quietly using a different brain.
JARVIS_MODEL_PROVIDER=

# --- A model running on THIS machine (ADR 0015) ---
# Free at the point of use, works with no internet, and no conversation leaves
# the house. Any runner that speaks the OpenAI-compatible
# /v1/chat/completions dialect works:
#
#   Ollama     http://127.0.0.1:11434   (ollama pull qwen3:8b)
#   LM Studio  http://127.0.0.1:1234    (start its local server)
#   llama.cpp  http://127.0.0.1:8080    (llama-server)
#
# LOOPBACK ONLY. A non-loopback URL is refused at startup, not silently
# downgraded: a "local" model on a remote host would ship every conversation
# off the machine while the UI labeled it local.
#
# Set BOTH or neither. When set, this takes precedence over ANTHROPIC_API_KEY —
# running a model locally is a deliberate choice to stop paying per message.
JARVIS_LOCAL_MODEL_URL=
JARVIS_LOCAL_MODEL=

# --- Data / storage ---
# DEV-ONLY: override Electron's userData directory (ignored when packaged).
# Used by scripts/runtime-probe.mjs for hermetic persistence checks.
JARVIS_USER_DATA_DIR=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Financial aggregation (Plaid-class, read-only scopes) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Deployment ---
VERCEL_TOKEN=

# --- App ---
NODE_ENV=development
PORT=3000
